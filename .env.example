# .env.example — committed to git, shows required variables with safe placeholders.
# Copy this file to .env and fill in real values. .env is NEVER committed
# (see RULES.md SEC-X-001 / SEC-X-002).
#
# CL-051 (2026-06-25): Migrated from Google AI Studio (gemini/ + GEMINI_API_KEY)
# to Vertex AI only (vertex_ai/ + GOOGLE_APPLICATION_CREDENTIALS service-account JSON).
# CL-055 (2026-06-26): JIT/JIC tool-calling requires vertex_ai/ (or gemini/) with the
# SDK-direct tool loop — do NOT use gemini/ as an emergency workaround without CL-055 code.
# GEMINI_API_KEY is OPTIONAL — kept as a fallback if Vertex AI credit runs out.

# --- Vertex AI (PRIMARY — required) ---
# Path to your Google Cloud service-account JSON key file.
# The service account must have the "Vertex AI User" role on your GCP project.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json
# Optional: override the GCP project and region (LiteLLM reads these for vertex_ai/ models)
# VERTEXAI_PROJECT=your-gcp-project-id
# VERTEXAI_LOCATION=us-central1

# --- LLM Model Chain (CL-063, decisions D12-D15, 2026-11-01) ---
# Primary: Gemini 4 Argon (GA Oct 2026, global endpoint only). Fallback after
# same-model retries: Gemini 3.8 Flash. Add LITELLM_MODEL_3.. only if needed.
LITELLM_MODEL_1=vertex_ai/gemini-4-argon
LITELLM_MODEL_2=vertex_ai/gemini-3.8-flash
VERTEX_LOCATION=global
REASONING_EFFORT=medium
LITELLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
DAILY_COST_LIMIT_USD=2.0

# --- Embeddings and de-duplication (D10, D15) ---
EMBEDDING_MODEL=vertex_ai/gemini-embedding-001
EMBEDDING_LOCATION=us-central1
EMBEDDING_DIMS=768
# Duplicate detection v2 (CL-070): cosine of headline + lead paragraph
DEDUPE_OVERLAP_THRESHOLD=0.85
DEDUPE_DUPLICATE_THRESHOLD=0.92

# --- Search budgets (provider chain Tavily -> Exa -> DuckDuckGo) ---
TAVILY_MONTHLY_CREDITS=1000
EXA_MONTHLY_BUDGET_USD=10
NETWORK_WAIT_SECONDS=300

# --- Google AI Studio (OPTIONAL fallback — only needed if Vertex AI credits run out) ---
# GEMINI_API_KEY=your_gemini_api_key_here

# --- Other LLM Providers (optional — used as fallback chain members) ---
MISTRAL_API_KEY=your_mistral_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Observability (LangSmith) ---
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=daily-jit-jic-newsletter

# --- Search ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- Email ---
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=your_sender_email@gmail.com
TARGET_EMAIL=your_recipient_email@gmail.com

# --- Token Limits ---
DAILY_TOKEN_LIMIT_GEMINI=900000
TOKEN_ALERT_THRESHOLD=0.95

# --- Search fallback (Exa, free monthly credit) ---
EXA_API_KEY=your_exa_api_key_here

# Production window (CL-075): scheduled runs stop after this date (YYYY-MM-DD). Empty = no end.
SCHEDULE_END_DATE=
